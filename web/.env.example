# Where the FastAPI server lives (server-side proxy target; not exposed to the browser)
API_URL=http://localhost:8000

# Must match AUTH_PROVIDER on the API: local | clerk
NEXT_PUBLIC_AUTH_PROVIDER=local

# Only when NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
