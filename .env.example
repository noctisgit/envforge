# ./install.sh creates .env from this file (with random secrets) — or copy it and fill in.
# .env is gitignored: never commit it. Provider keys for the web app are added per user in
# the UI (Profile); the keys below are for the CLI.

# --- Model providers (set the ones you use) ---
# Native Anthropic API (default provider)
ANTHROPIC_API_KEY=

# OpenAI direct
OPENAI_API_KEY=

# Vercel AI Gateway (OpenAI-compatible; model ids look like "anthropic/claude-opus-5")
AI_GATEWAY_API_KEY=
# Override only if Vercel changes it:
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Self-hosted vLLM on your GPU box (OpenAI-compatible). Reach it over Tailscale.
# VLLM_BASE_URL=http://100.x.y.z:8000/v1
# VLLM_API_KEY=not-needed

# --- Defaults ---
# Model string format: <provider>:<model-id>   e.g. anthropic:claude-sonnet-5-5, vercel:anthropic/claude-sonnet-4.5
ENVFORGE_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
ENVFORGE_DATA_DIR=./data

# ============ Web layer (optional; see docs/WEB.md) ============
# Postgres in prod; SQLite for local dev
DATABASE_URL=sqlite:///./data/envforge.db
POSTGRES_PASSWORD=change-me            # used by docker-compose.yml

# local | clerk
AUTH_PROVIDER=local
# >= 32 chars. Signs sessions AND encrypts stored provider keys. Never change after keys are saved.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ALLOW_SIGNUP=true                      # install.sh asks; false = admin creates accounts
# Where the web UI listens on the host (docker compose). 127.0.0.1 = this machine only:
# put nginx / Caddy / cloudflared / a port forward in front. 0.0.0.0 = whole network.
WEB_LISTEN=127.0.0.1
WEB_PORT=3000
# Dev-only host ports (bound to 127.0.0.1): the API and Postgres
# API_PORT=8000
# POSTGRES_PORT=5432
# Clerk only
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
# Let workspaces without their own key use the server's keys above (shared pool)?
ALLOW_SERVER_KEYS=false
COOKIE_SECURE=false                    # true behind HTTPS
# vLLM base URLs: public hosts only; admin accounts may also use these CIDRs (Tailscale).
# true allows private networks for everyone (single-user installs only).
BASE_URL_ALLOW_PRIVATE=false
BASE_URL_ALLOW_CIDRS=100.64.0.0/10
MAX_ACTIVE_RUNS_PER_WORKSPACE=3        # queued + running
# GPU boxes (Settings → GPU boxes): adding, serving on and training on them is admin-only
GPU_BOXES_ADMIN_ONLY=true
# TRAIN_MAX_HOURS=24                   # a training job running longer is stopped
LOGIN_ATTEMPTS_PER_MINUTE=10           # per client IP and per email
SIGNUPS_PER_HOUR=5                     # per client IP
# The header your reverse proxy sets with the visitor's IP (the rate limits key on it):
# x-forwarded-for for Caddy/nginx, cf-connecting-ip behind Cloudflare
CLIENT_IP_HEADER=x-forwarded-for

# Sandbox packs (repofix): docker (isolated) | local (NOT isolated; tests/dev only)
ENVFORGE_SANDBOX=docker
# ENVFORGE_SANDBOX_IMAGE=python:3.12-slim

# GPU box defaults for `envforge compute` (docs/COMPUTE.md)
# ENVFORGE_GPU_HOST=gpu-1
# HF_TOKEN=

# Next.js (compose build args)
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
