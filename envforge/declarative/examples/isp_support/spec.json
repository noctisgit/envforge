  "tools": [
    {
      "name": "lookup_customer",
      "description": "Show a customer's account (name, service area, autopay, status).",
      "category": "observe",
      "params": [
        {
          "name": "customer_id",
          "type": "string",
          "enum": null,
          "description": "e.g. C-1101",
          "required": true
        }
      ],
      "effect": {
        "op": "get",
        "collection": "customers",
        "key_param": "customer_id"
      }
    },
    {
      "name": "find_subscriptions",
