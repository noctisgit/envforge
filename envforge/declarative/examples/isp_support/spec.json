{
  "format_version": 1,
  "archetype": "support_desk",
  "name": "isp-support",
  "title": "ISP support desk",
  "description": "Handle home-internet support tickets (outages, devices, billing, plans) under desk policy.",
  "overview": "The agent works the support desk of a fictional home-internet provider. Each task is one customer ticket: no connection, a slow line, a wrong bill, a suspended service, a plan change. The agent investigates the customer's records with read-only tools, may ask the customer questions, takes the right actions (reboot, reprovision, credit, restore, change plan, escalate) and records a resolution. Policies — credit limits, identity checks, no restarts during outages, never touching another customer's account — are checked by code; breaking one caps the reward.",
  "agent_role": "You are a tier-1 support agent at Lumen Broadband, a home-internet provider.\nYou handle one customer ticket at a time using the support console tools. Today is 2026-10-19.\n\nWork like a careful agent: look up the customer's account, devices, subscriptions and invoices\nbefore changing anything, take the smallest set of actions that fixes the customer's problem,\nand do not take actions the customer did not need.\n\nDesk rules:\n- Connectivity: a device that is offline with no linked outage usually needs a reboot. New or\n  replacement devices, and lines running below the plan's speed (provisioning pending or\n  mismatch), need reprovisioning. A device with no power or physical damage (status faulty)\n  needs the field_technicians team.\n- Outages: if the customer's area has an active outage, explain it (resolve as known_outage).\n- Late fees are charged in error when the invoice was paid on or before its due date: credit\n  the fee on that invoice.\n- Reconnection fees are waived when the payment arrived before the suspension date.\n- Only restore a suspended subscription when all of its invoices are paid.\n- Goodwill for lost service: $5 per full day without service, credited on the most recent\n  invoice (period 2026-10).\n- A line provisioned below its plan: credit the price difference between the plan and the\n  plan it actually ran at, on the most recent invoice.\n- Cancellation requests go to the retention team.\n",
  "resolution_categories": [
    "connectivity_restored",
    "device_reprovisioned",
    "known_outage",
    "billing_credit_applied",
    "billing_escalated",
    "service_restored",
    "plan_changed",
    "technician_dispatched",
    "retention_escalated",
    "information_provided"
  ],
  "answer_topics": [
    "account_pin",
    "symptoms",
    "device_lights",
    "when_started",
    "payment_date",
    "desired_plan"
  ],
