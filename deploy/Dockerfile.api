# API + worker image (same image, different command). CPU only.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
# openssh-client: the compute worker drives GPU boxes with the system ssh/scp
# (envforge/compute/ssh.py); nothing else in the image uses it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY envforge ./envforge
# pii = tier-2 PII model (GLiNER + CPU-only torch from PyTorch's CPU index, ~+800 MB
# unpacked). The model weights (~1.1 GB) are NOT baked in: they download on first use
# into HF_HOME, which lives on the data volume, so it happens once per deployment.
RUN uv sync --frozen --no-dev --extra web --extra privacy --extra pii
# spaCy model for the builder's optional local name detection (Presidio). Small and fast;
# set ENVFORGE_NER_MODEL=en_core_web_lg (and install it) for better recall.
RUN uv pip install --python /app/.venv/bin/python \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
ENV PATH="/app/.venv/bin:$PATH" \
    HF_HOME=/data/hf-cache
EXPOSE 8000
CMD ["uvicorn", "envforge.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
