# API + worker image (same image, different command). CPU only.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY envforge ./envforge
RUN uv sync --frozen --no-dev --extra web --extra privacy
# spaCy model for the builder's optional local name detection (Presidio). Small and fast;
# set ENVFORGE_NER_MODEL=en_core_web_lg (and install it) for better recall.
RUN uv pip install --python /app/.venv/bin/python \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["uvicorn", "envforge.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
